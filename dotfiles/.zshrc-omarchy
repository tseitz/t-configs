# Omarchy's bash defaults, bridged to zsh.
#
# Omarchy keeps its aliases, functions, env and keybindings in
# /usr/share/omarchy/default/bash/ and wires them in via /etc/skel/.bashrc, so
# a zsh login shell gets none of them. This sources Omarchy's own files where
# bash and zsh agree, and reimplements only the four that are bash-only.
# No-op on a machine without Omarchy.
#
# Two phases, because env and aliases belong at opposite ends of .zshrc:
#   source .zshrc-omarchy env     PATH and environment. Must run BEFORE
#                                 .zshrc activates mise, whose shims
#                                 env-bootstrap is what puts on PATH.
#   source .zshrc-omarchy shell   aliases, functions, keybindings. Runs AFTER
#                                 the personal aliases, so Omarchy wins.

omarchy_bash="${OMARCHY_PATH:-/usr/share/omarchy}/default/bash"
[[ -d "$omarchy_bash" ]] || return 0

if [[ "${1:-shell}" == env ]]; then
  # OMARCHY_PATH, mise shims, ~/.local/bin. Guards against duplicate PATH entries.
  [[ -r "$omarchy_bash/env-bootstrap" ]] && source "$omarchy_bash/env-bootstrap"
  # EDITOR, BROWSER, BAT_THEME, MANPAGER, locale fallback.
  [[ -r "$omarchy_bash/envs" ]] && source "$omarchy_bash/envs"
  unset omarchy_bash
  return 0
fi

# ---- Sourced as-is: bash syntax that zsh also accepts ----

_omarchy_srcs=("$omarchy_bash"/aliases(N) "$omarchy_bash"/fns/*(N))
if (( ${#_omarchy_srcs} )); then
  # zsh refuses to define a function whose name is already an alias, and that
  # parse error aborts the whole FILE -- one collision costs every function
  # after it. oh-my-zsh's git plugin claims ga and gd, which Omarchy defines as
  # worktree functions. Read the names from Omarchy's files so a function added
  # by a later release cannot hit this silently.
  for _omarchy_name in ${(f)"$(grep -hoE '^[[:space:]]*[a-zA-Z_][a-zA-Z0-9_-]*\(\)' \
        "${_omarchy_srcs[@]}" 2>/dev/null | sed -E 's/^[[:space:]]*//; s/\(\)$//')"}; do
    [[ -n "$_omarchy_name" ]] && unalias -- "$_omarchy_name" 2>/dev/null
  done

  # KNOWN GAP: format-drive prompts with `read -rp`. zsh reads -p as "from the
  # coprocess", so the prompt never appears and the confirmation reads empty.
  # It fails closed -- the function aborts before touching the disk -- but it
  # cannot succeed here either. Run that one from bash.
  for _omarchy_src in "${_omarchy_srcs[@]}"; do source "$_omarchy_src"; done
fi
unset _omarchy_srcs _omarchy_src _omarchy_name

# ---- Replacements for the bash-only files ----

# for default/bash/shell
setopt APPEND_HISTORY INC_APPEND_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE
HISTSIZE=32768
SAVEHIST=$HISTSIZE
[[ -n "$HISTFILE" ]] || HISTFILE="$HOME/.zsh_history"
unsetopt HASH_CMDS HASH_DIRS   # mise swaps a shim's target mid-session

# for default/bash/init. mise is activated by .zshrc already. starship is left
# out because .zshrc sets the spaceship theme; running both leaves whichever
# initialised last in charge. To prefer starship, set ZSH_THEME= and run
# `eval "$(starship init zsh)"` in .zshrc-local.
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"
if command -v try &>/dev/null; then
  try() {
    unfunction try
    eval "$(SHELL=$(command -v zsh) command try init ~/Work/tries)"
    try "$@"
  }
fi
if command -v fzf &>/dev/null; then
  [[ -f /usr/share/fzf/completion.zsh ]]   && source /usr/share/fzf/completion.zsh
  [[ -f /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
fi

# for default/bash/inputrc, using ZLE. default/bash/completions has no zsh
# port, so `omarchy <tab>` will not complete subcommands.
if [[ -o interactive ]]; then
  zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
  zstyle ':completion:*' menu select
  setopt AUTO_MENU ALWAYS_TO_END MARK_DIRS
  bindkey '^[[Z' reverse-menu-complete
  autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
  zle -N up-line-or-beginning-search
  zle -N down-line-or-beginning-search
  bindkey '^[[A' up-line-or-beginning-search
  bindkey '^[[B' down-line-or-beginning-search
  bindkey '^[OA' up-line-or-beginning-search
  bindkey '^[OB' down-line-or-beginning-search
fi

unset omarchy_bash
