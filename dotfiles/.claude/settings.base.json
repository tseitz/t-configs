{
  "attribution" : {
    "commit" : "",
    "pr" : ""
  },
  "awaySummaryEnabled" : false,
  "editorMode" : "vim",
  "effortLevel" : "high",
  "enabledPlugins" : {
    "astral@astral-sh" : true,
    "chrome-devtools-mcp@claude-plugins-official" : true,
    "claude-md-management@claude-plugins-official" : false,
    "code-review@claude-plugins-official" : true,
    "code-simplifier@claude-plugins-official" : false,
    "explanatory-output-style@claude-plugins-official" : false,
    "github@claude-plugins-official" : true,
    "mattpocock-skills@mattpocock" : true,
    "playwright@claude-plugins-official" : true,
    "pr-review-toolkit@claude-plugins-official" : true,
    "pyright-lsp@claude-plugins-official" : true,
    "security-guidance@claude-plugins-official" : true,
    "sentry@claude-plugins-official" : true,
    "superpowers@claude-plugins-official" : false,
    "typescript-lsp@claude-plugins-official" : true
  },
  "env" : {
    "CLAUDE_CODE_ATTRIBUTION_HEADER" : "0",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC" : "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY" : "0",
    "CLAUDE_CODE_SCROLL_SPEED" : "5"
  },
  "extraKnownMarketplaces" : {
    "astral-sh" : {
      "source" : {
        "repo" : "astral-sh\/claude-code-plugins",
        "source" : "github"
      }
    },
    "mattpocock" : {
      "source" : {
        "repo" : "mattpocock\/skills",
        "source" : "github"
      }
    }
  },
  "outputStyle" : "My Concise",
  "hooks" : {
    "PostToolUse" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/scripts\/hooks\/post-edit-accumulator.js",
            "type" : "command"
          },
          {
            "command" : "~\/.claude\/scripts\/hooks\/post-edit-comment-length.js",
            "type" : "command"
          },
          {
            "command" : "~\/.claude\/scripts\/hooks\/post-edit-comment-style.js",
            "type" : "command"
          }
        ],
        "matcher" : "Edit|Write|MultiEdit"
      },
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/scripts\/hooks\/post-bash-pr-created.js",
            "type" : "command"
          },
          {
            "command" : "~\/.claude\/scripts\/hooks\/capture-sandbox-friction.sh",
            "type" : "command"
          }
        ],
        "matcher" : "Bash"
      }
    ],
    "PreCompact" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/scripts\/hooks\/pre-compact.js",
            "type" : "command"
          }
        ],
        "matcher" : "*"
      }
    ],
    "PreToolUse" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/scripts\/hooks\/config-protection.js",
            "type" : "command"
          }
        ],
        "matcher" : "Write|Edit|MultiEdit"
      },
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/scripts\/hooks\/route-subagent-model.js",
            "timeout" : 10,
            "type" : "command"
          }
        ],
        "matcher" : "Agent|Task"
      },
      {
        "hooks" : [
          {
            "command" : "~/.claude/scripts/hooks/jev-guard.js",
            "timeout" : 20,
            "type" : "command"
          }
        ],
        "matcher" : "Bash"
      },
      {
        "hooks" : [
          {
            "command" : "~/.claude/scripts/hooks/direnv-wrap.js",
            "type" : "command"
          }
        ],
        "matcher" : "Bash"
      }
    ],
    "SessionEnd" : [
      {
        "hooks" : [
          {
            "command" : "__claudebar_hook() { PORT=$(cat \"$HOME\/.claude\/claudebar-hook-port\" 2>\/dev\/null || echo 19847); cat | curl -s -X POST \"http:\/\/localhost:${PORT}\/hook\" -H 'Content-Type: application\/json' -d @- > \/dev\/null 2>&1 & }; __claudebar_hook",
            "type" : "command"
          }
        ],
        "matcher" : ".*"
      },
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/scripts\/hooks\/session-resume-end.js",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "__claudebar_hook() { PORT=$(cat \"$HOME\/.claude\/claudebar-hook-port\" 2>\/dev\/null || echo 19847); cat | curl -s -X POST \"http:\/\/localhost:${PORT}\/hook\" -H 'Content-Type: application\/json' -d @- > \/dev\/null 2>&1 & }; __claudebar_hook",
            "type" : "command"
          }
        ],
        "matcher" : ".*"
      },
      {
        "hooks" : [
          {
            "command" : "node \"$HOME\/.claude\/scripts\/settings-drift.js\" --hook 2>\/dev\/null || true",
            "timeout" : 10,
            "type" : "command"
          }
        ]
      }
    ],
    "Stop" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/scripts\/hooks\/stop-format-typecheck.js",
            "timeout" : 300,
            "type" : "command"
          }
        ],
        "matcher" : "*"
      },
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/scripts\/hooks\/stop-comment-length-report.js",
            "timeout" : 10,
            "type" : "command"
          }
        ],
        "matcher" : "*"
      },
      {
        "hooks" : [
          {
            "async" : true,
            "command" : "~\/.claude\/scripts\/hooks\/desktop-notify.js",
            "timeout" : 10,
            "type" : "command"
          }
        ],
        "matcher" : "*"
      },
      {
        "hooks" : [
          {
            "command" : "__claudebar_hook() { PORT=$(cat \"$HOME\/.claude\/claudebar-hook-port\" 2>\/dev\/null || echo 19847); cat | curl -s -X POST \"http:\/\/localhost:${PORT}\/hook\" -H 'Content-Type: application\/json' -d @- > \/dev\/null 2>&1 & }; __claudebar_hook",
            "type" : "command"
          }
        ],
        "matcher" : ".*"
      }
    ],
    "SubagentStart" : [
      {
        "hooks" : [
          {
            "command" : "__claudebar_hook() { PORT=$(cat \"$HOME\/.claude\/claudebar-hook-port\" 2>\/dev\/null || echo 19847); cat | curl -s -X POST \"http:\/\/localhost:${PORT}\/hook\" -H 'Content-Type: application\/json' -d @- > \/dev\/null 2>&1 & }; __claudebar_hook",
            "type" : "command"
          }
        ],
        "matcher" : ".*"
      }
    ],
    "SubagentStop" : [
      {
        "hooks" : [
          {
            "command" : "__claudebar_hook() { PORT=$(cat \"$HOME\/.claude\/claudebar-hook-port\" 2>\/dev\/null || echo 19847); cat | curl -s -X POST \"http:\/\/localhost:${PORT}\/hook\" -H 'Content-Type: application\/json' -d @- > \/dev\/null 2>&1 & }; __claudebar_hook",
            "type" : "command"
          }
        ],
        "matcher" : ".*"
      }
    ],
    "TaskCompleted" : [
      {
        "hooks" : [
          {
            "command" : "__claudebar_hook() { PORT=$(cat \"$HOME\/.claude\/claudebar-hook-port\" 2>\/dev\/null || echo 19847); cat | curl -s -X POST \"http:\/\/localhost:${PORT}\/hook\" -H 'Content-Type: application\/json' -d @- > \/dev\/null 2>&1 & }; __claudebar_hook",
            "type" : "command"
          }
        ],
        "matcher" : ".*"
      }
    ],
    "UserPromptSubmit" : [
      {
        "hooks" : [
          {
            "command" : "input=$(cat); echo \"$input\" | jq -e '.prompt | test(\"^\\\\s*\/extra-usage\\\\s*$\")' > \/dev\/null 2>&1 && echo '{\"continue\": false, \"stopReason\": \"Blocked \/extra-usage — run it intentionally from settings if needed.\"}' || true",
            "type" : "command"
          }
        ]
      }
    ]
  },
  "sandbox" : {
    "autoAllowBashIfSandboxed" : true,
    "enabled" : false,
    "enableWeakerNetworkIsolation" : true,
    "excludedCommands" : [
      "chrome-headless-shell",
      "mkdir *",
      "git *",
      "gcloud *",
      "kubectl *",
      "brew *",
      "gh *",
      "herdr *"
    ],
    "filesystem" : {
      "allowWrite" : [
        "~\/.cache",
        "~\/.matplotlib",
        "~\/Library\/Caches\/mise",
        "~\/.docker\/buildx",
        "~\/.local\/share\/mise",
        "~\/.local\/state\/mise",
        "~\/Library\/pnpm",
        "~\/.bundle",
        "~\/.npm",
        "~\/.config\/rclone",
        "~\/t-configs",
        "~\/Code\/worktrees"
      ]
    },
    "network" : {
      "allowedDomains" : [
        "github.com",
        "api.github.com",
        "rubygems.org",
        "index.rubygems.org",
        "thinknear.jfrog.io",
        "jfrog-prod-use1-shared-virginia-main.s3.amazonaws.com",
        "results-receiver.actions.githubusercontent.com",
        "localhost",
        "127.0.0.1",
        "::1"
      ],
      "allowLocalBinding" : true,
      "allowUnixSockets" : [
        "~\/.docker\/run\/docker.sock"
      ]
    }
  },
  "skillOverrides" : {
    "sentry:sentry-android-sdk" : "off",
    "sentry:sentry-cloudflare-sdk" : "off",
    "sentry:sentry-cocoa-sdk" : "off",
    "sentry:sentry-code-review" : "off",
    "sentry:sentry-dotnet-sdk" : "off",
    "sentry:sentry-elixir-sdk" : "off",
    "sentry:sentry-feature-setup" : "off",
    "sentry:sentry-flutter-sdk" : "off",
    "sentry:sentry-go-sdk" : "off",
    "sentry:sentry-nestjs-sdk" : "off",
    "sentry:sentry-nextjs-sdk" : "off",
    "sentry:sentry-otel-exporter-setup" : "off",
    "sentry:sentry-php-sdk" : "off",
    "sentry:sentry-pr-code-review" : "off",
    "sentry:sentry-react-native-sdk" : "off",
    "sentry:sentry-react-router-framework-sdk" : "off",
    "sentry:sentry-ruby-sdk" : "off",
    "sentry:sentry-sdk-setup" : "off",
    "sentry:sentry-sdk-skill-creator" : "off",
    "sentry:sentry-sdk-upgrade" : "off",
    "sentry:sentry-svelte-sdk" : "off",
    "sentry:sentry-tanstack-start-sdk" : "off"
  },
  "skipDangerousModePermissionPrompt" : true,
  "statusLine" : {
    "command" : "bash $HOME\/.claude\/statusline-command.sh",
    "type" : "command"
  },
  "permissions" : {
    "allow" : [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "mcp__plugin_atlassian_atlassian__getJiraIssue"
    ],
    "ask" : [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git -c *)",
      "Bash(HUSKY=0 *)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git config *core.hooksPath*)",
      "Bash(gh repo create *--public*)",
      "Bash(gh repo edit *--visibility*)",
      "Bash(gh repo delete*)",
      "Bash(gh gist create*)",
      "Bash(sudo *)",
      "Bash(sh)",
      "Bash(bash)",
      "Bash(zsh)",
      "Bash(env)",
      "Bash(printenv*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "mcp__alpaca__place_stock_order",
      "mcp__alpaca__place_crypto_order",
      "mcp__alpaca__place_option_order",
      "mcp__alpaca__replace_order_by_id",
      "mcp__alpaca__cancel_order_by_id",
      "mcp__alpaca__cancel_all_orders",
      "mcp__alpaca__close_position",
      "mcp__alpaca__close_all_positions",
      "mcp__alpaca__exercise_options_position",
      "mcp__alpaca__do_not_exercise_options_position",
      "mcp__alpaca__create_locate",
      "mcp__alpaca__update_account_config",
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Google_Drive__share_file"
    ],
    "deny" : [
      "Bash(mkfs*)",
      "Bash(diskutil *erase*)",
      "Bash(dd * of=/dev/*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/typesafe/**)",
      "Read(~/.config/gh/hosts.yml)"
    ],
    "defaultMode" : "auto"
  },
  "tui" : "fullscreen",
  "wheelScrollAccelerationEnabled" : false
}
