{
  // ════════════════════════════════════════════════════════════════
  //  Shared editor settings — canonical file symlinked by BOTH
  //  VS Code (~/Library/Application Support/Code/User/settings.json)
  //  and Cursor (~/Library/Application Support/Cursor/User/settings.json).
  //  Editor-specific keys are harmless in the other editor (ignored).
  //  Edit here; both editors pick it up.
  // ════════════════════════════════════════════════════════════════

  // ── Editor: Appearance ──────────────────────────────────────────
  // "editor.fontFamily": "'LythMono Nerd Font', Menlo, Monaco, 'Courier New', monospace",
  "editor.fontFamily": "'Geist Mono', 'Fira Code', Menlo, Monaco, 'Courier New', monospace",
  "editor.fontSize": 12,
  "editor.fontLigatures": true,
  "editor.cursorBlinking": "phase",
  "editor.minimap.enabled": true,
  "editor.minimap.autohide": "mouseover",
  "editor.renderWhitespace": "trailing",
  "editor.stickyScroll.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  // Theme key must match "workbench.colorTheme" above, or the rules never apply.
  "editor.semanticTokenColorCustomizations": {
    "[Dark Modern]": {
      "rules": {
        "selfParameter": "#569CD6",
        "clsParameter": "#569CD6",
      },
    },
  },

  // ── Editor: Behavior ────────────────────────────────────────────
  "editor.tabSize": 2,
  "editor.autoIndent": "full",
  "editor.detectIndentation": false,
  "editor.dragAndDrop": false,
  "editor.formatOnPaste": false,
  "editor.linkedEditing": true,
  "editor.snippetSuggestions": "top",
  "editor.tabCompletion": "on",
  "editor.suggestSelection": "first",
  "editor.suggest.localityBonus": true,
  "editor.quickSuggestions": {
    "strings": true,
  },
  "editor.mouseWheelScrollSensitivity": 1.5,
  "editor.smoothScrolling": true,
  "editor.accessibilitySupport": "off",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.suppressSuggestions": true,

  // ── Workbench ───────────────────────────────────────────────────
  "workbench.colorTheme": "Dark Modern",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "newUntitledFile",
  "workbench.editor.openPositioning": "right",
  "workbench.editor.pinnedTabSizing": "shrink",
  "window.autoDetectColorScheme": false,

  // ── Files ───────────────────────────────────────────────────────
  // Nothing global here on purpose. Hiding files globally makes a project look
  // empty for reasons the project cannot see. Exclude per project instead.
  "files.watcherExclude": {
    "**/__pycache__/*/**": true,
    "**/.venv/*/**": true,
  },

  // ── Search ──────────────────────────────────────────────────────
  "search.smartCase": true,
  "search.useIgnoreFiles": true,

  // ── Explorer & Diff ─────────────────────────────────────────────
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "extensions.ignoreRecommendations": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
  },

  // ── Terminal ────────────────────────────────────────────────────
  "terminal.integrated.fontSize": 12.2,
  "terminal.integrated.scrollback": 5000,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.automationProfile.osx": {
    "path": "/bin/zsh",
  },
  "terminal.integrated.autoReplies": {
    "[Oh My Zsh] Would you like to check for updates? [Y/n]": "Y\r",
    "[oh-my-zsh] Would you like to update? [Y/n]": "Y\r",
  },
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.explorerKind": "external",
  "terminal.external.osxExec": "Warp.app",

  // ── Git ─────────────────────────────────────────────────────────
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.autofetch": true,
  "git.autoStash": true,
  "git.ignoreRebaseWarning": true,
  // All GitHub remotes are SSH; VS Code's GIT_ASKPASS injection only ever
  // served stale OAuth tokens to terminal git.
  "git.terminalAuthentication": false,

  // ── GitLens ─────────────────────────────────────────────────────
  "gitlens.codeLens.enabled": false,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.hovers.currentLine.details": false,
  "gitlens.hovers.annotations.details": false,
  "gitlens.advanced.messages": {
    "suppressCommitHasNoPreviousCommitWarning": false,
    "suppressCommitNotFoundWarning": false,
    "suppressFileNotUnderSourceControlWarning": false,
    "suppressGitVersionWarning": false,
    "suppressLineUncommittedWarning": false,
    "suppressNoRepositoryWarning": false,
  },
  "gitlens.menus": {
    "editor": false,
    "editorGroup": false,
    "editorTab": {
      "compare": false,
      "history": false,
      "remote": true,
    },
    "explorer": {
      "compare": true,
      "history": true,
      "remote": true,
    },
  },

  // ── GitHub Pull Requests ────────────────────────────────────────
  "githubPullRequests.pullBranch": "never",

  // ── CSS & Tailwind ──────────────────────────────────────────────
  "css.lint.duplicateProperties": "warning",
  "css.lint.float": "warning",
  "tailwindCSS.includeLanguages": {
    "plaintext": "html",
  },

  // ── HTML ────────────────────────────────────────────────────────
  "html.format.unformatted": "",

  // ── JavaScript / TypeScript ─────────────────────────────────────
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.suggest.paths": false,
  "typescript.tsserver.log": "off",
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "prettier.printWidth": 120,

  // ── Python ──────────────────────────────────────────────────────
  "autoDocstring.startOnNewLine": true,
  "python.languageServer": "Pylance",
  "python.envFile": "",
  // No "python.defaultInterpreterPath" on purpose. A global path pins every project to one
  // interpreter, and it breaks as soon as that version is uninstalled. Left unset, the Python
  // extension finds each project's own venv. "Mise: Configure extension" re-adds this line —
  // set it per project in .vscode/settings.json instead.

  // ── Ruby ────────────────────────────────────────────────────────
  "rubyLsp.formatter": "rubocop",

  // ── Svelte ──────────────────────────────────────────────────────
  "svelte.enable-ts-plugin": true,

  // ── Security & Remote ───────────────────────────────────────────
  "security.workspace.trust.untrustedFiles": "open",
  "remote.autoForwardPortsSource": "hybrid",

  // ── Extensions ──────────────────────────────────────────────────
  "markdownlint.config": {
    "MD001": false,
    "MD007": {
      "indent": 2,
    },
    "MD013": false,
    "MD025": false,
  },
  "todo-tree.general.tags": ["BUG", "HACK", "FIXME", "TODO", "XXX", "[ ]", "[x]"],
  "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^\\s*(-|\\d+.))\\s*($TAGS)",
  // Homebrew path. Mac only — on Windows this key is ignored and todo-tree
  // falls back to the ripgrep it ships with, which is fine.
  "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",
  "errorLens.excludeBySource": ["ts(2304)"],
  "claudeCode.preferredLocation": "panel",
  // Homebrew path. Mac only — see the todo-tree note above.
  "mise.binPath": "/opt/homebrew/bin/mise",
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml",
  ],
  // Covers both redhat.java and redhat.vscode-yaml. The old "jdk.telemetry.enabled"
  // here belonged to Oracle's Java extension, which is not installed, so it did nothing.
  "redhat.telemetry.enabled": false,

  // ── Java (redhat.java) ──────────────────────────────────────────
  //  Both keys are "window" scope, so VS Code IGNORES them in a folder's
  //  .vscode/settings.json. User settings or a .code-workspace are the only
  //  places they take effect — which is why they live here and not in the repo.
  //  "automatic" on both means the feature runs without the confirm prompt;
  //  "disabled" would silence the prompt by turning the feature off instead.
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.compile.nullAnalysis.mode": "automatic",
  "gitlens.telemetry.enabled": false,

  // ── Cursor-specific (ignored in VS Code) ────────────────────────
  "cursor.cpp.disabledLanguages": ["plaintext", "scminput"],
  "cursorpyright.disableLanguageServices": true,

  // ── Vim ─────────────────────────────────────────────────────────
  //  Kept deliberately small, and kept in step with Neovim.
  //  The matching half lives in ../nvim/lua/config/keymaps.lua.
  //  Change one, change the other.
  //
  //  Leader is space in both. Neovim (LazyVim) uses space too.
  "vim.leader": " ",
  //  Neovim sets clipboard = "unnamedplus", so there y and p use the system
  //  clipboard. This makes VS Code behave the same way. Note that d, x and c
  //  overwrite the clipboard too — that is the price, and Neovim already
  //  worked this way.
  "vim.useSystemClipboard": true,
  "vim.visualModeKeyBindings": [
    // Move the selected lines. This replaces visual-mode J (join lines),
    // on purpose. Neovim also keeps LazyVim's <A-j>/<A-k> for the same thing.
    {
      "before": ["J"],
      "commands": ["editor.action.moveLinesDownAction"],
    },
    {
      "before": ["K"],
      "commands": ["editor.action.moveLinesUpAction"],
    },
  ],

  // ── Language-Specific Overrides ─────────────────────────────────
  "[python]": {
    "editor.tabSize": 4,
    "editor.formatOnSave": true,
    "editor.detectIndentation": true,
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.detectIndentation": true,
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false,
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[svelte]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "svelte.svelte-vscode",
  },
  "[ruby]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Shopify.ruby-lsp",
  },
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode",
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
  },
}
