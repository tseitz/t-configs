dotfiles/.zshrc-env-vars
dotfiles/.zshrc-local
.claude.json

# Work commit identity — this repo is public. Seeded from .gitconfig-work.example.
dotfiles/.gitconfig-work

# Docker Desktop rewrites the whole marker block in here on every start, so any
# edit is lost and the file churns. Nothing of ours lives in it — put shell
# config in .zshrc instead.
dotfiles/.zprofile

# dotfiles/.claude — track everything EXCEPT runtime state and secrets
# settings.json is machine-owned (seeded from settings.base.json); never commit it.
# settings.base.json is the shared, hand-curated baseline — that one IS tracked.
dotfiles/.claude/settings.json
dotfiles/.claude/settings.local.json
dotfiles/.claude/plugins/cache/
dotfiles/.claude/plugins/blocklist.json
dotfiles/.claude/plugins/install-counts-cache.json
dotfiles/.claude/plugins/installed_plugins.json
dotfiles/.claude/plugins/known_marketplaces.json
dotfiles/.claude/plugins/data/
dotfiles/.claude/plugins/marketplaces/

# Skills: ignore work-specific skills (may contain company-internal references)
dotfiles/.claude/skills/work/

# Sandbox-friction capture log — per-project runtime state, written by the hook
.claude/sandbox-friction.jsonl

.DS_Store
.tmp/